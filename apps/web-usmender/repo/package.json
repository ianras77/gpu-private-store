{
  "name": "usmender",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "dev:matrix-appservice": "npm --workspace apps/matrix-appservice run dev",
    "dev:ios": "npm --workspace apps/ios run dev",
    "lint": "npm --workspaces run lint",
    "typecheck": "npm --workspaces run typecheck",
    "test": "npm --workspace packages/shared run test"
  }
}
