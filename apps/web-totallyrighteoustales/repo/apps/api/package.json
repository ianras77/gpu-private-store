{
  "name": "@trt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node --import tsx src/server.ts",
    "start:worker": "node --import tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"(api) lint skipped\"",
    "format": "prettier -w \"src/**/*.{ts,tsx,md}\" \"prisma/**/*.{prisma,ts}\"",
    "test": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/s3-request-presigner": "^3.645.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@prisma/client": "^5.21.1",
    "@trt/shared": "workspace:*",
    "bullmq": "^5.16.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "jose": "^5.8.0",
    "nanoid": "^5.0.7",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "prisma": "^5.21.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
