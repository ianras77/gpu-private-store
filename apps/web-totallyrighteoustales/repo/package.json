{
  "name": "totallyrighteoustales",
  "private": true,
  "version": "0.5.0",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm -C apps/api dev\" \"pnpm -C apps/web dev\"",
    "dev:api": "pnpm -C apps/api dev",
    "dev:web": "pnpm -C apps/web dev",
    "dev:ios": "pnpm -C apps/ios start",
    "dev:worker": "pnpm -C apps/api dev:worker",
    "stack:up": "bash scripts/stack.sh up",
    "stack:down": "bash scripts/stack.sh down",
    "stack:logs": "bash scripts/stack.sh logs",
    "stack:ps": "bash scripts/stack.sh ps",
    "stack:restart": "bash scripts/stack.sh restart",
    "start:api": "pnpm -C apps/api start",
    "start:worker": "pnpm -C apps/api start:worker",
    "start:web": "pnpm -C apps/web start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
