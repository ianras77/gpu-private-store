    },
    {
      "type": "text",
      "label": "Models directory",
      "env_variable": "LOCALAI_MODELS_PATH",
      "default": "/models",
      "required": true
    },
    {
      "type": "boolean",
      "label": "Enable LocalAI debug logs",
      "env_variable": "LOCALAI_DEBUG",
      "default": false,
      "required": true
    },
    {
      "type": "boolean",
      "label": "Enable LocalAI P2P swarm mode",
      "env_variable": "LOCALAI_P2P",
      "default": true,
      "required": true
    },
    {
      "type": "text",
      "label": "LocalAI P2P network ID",
      "env_variable": "LOCALAI_P2P_NETWORK_ID",
      "default": "rassylocalgpt-m40-master",
      "required": true
    },
    {
      "type": "boolean",
      "label": "Enable federated swarm mode",
      "env_variable": "LOCALAI_FEDERATED",
      "default": true,
      "required": true
    },
    {
