      "required": true
    },
    {
      "type": "boolean",
      "label": "Limit P2P resource use",
      "env_variable": "LOCALAI_P2P_ENABLE_LIMITS",
      "default": true,
      "required": true
    },
    {
      "type": "boolean",
      "label": "LAN-only P2P discovery",
      "env_variable": "LOCALAI_P2P_DISABLE_DHT",
      "default": true,
      "required": true
