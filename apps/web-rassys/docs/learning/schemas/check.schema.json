{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rassy module v1 knowledge check",
  "description": "Also require unique option ids and answer membership in options; these cross-field checks need application validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "options",
    "answer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "feedback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "feedback": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "answer": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    }
  }
}
