{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rassy module v1 front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "version",
    "status",
    "title",
    "summary",
    "topic",
    "objectives"
  ],
  "properties": {
    "schema": {
      "const": "rassy-module/v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "cover": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^assets/(?:[a-z0-9_-]+/)*[a-z0-9_-]+\\.(?:png|jpe?g|webp|avif|gif)$"
    },
    "cover_alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "related": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    }
  },
  "dependentRequired": {
    "cover": [
      "cover_alt"
    ],
    "cover_alt": [
      "cover"
    ]
  }
}
