{
  "expo": {
    "name": "Mr Rassy Radio",
    "slug": "mr-rassy-radio",
    "scheme": "mrrassyradio",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c16"
    },
    "plugins": [["expo-audio", { "recordAudioAndroid": false, "microphonePermission": false }]],
    "ios": {
      "bundleIdentifier": "online.rassy.mrrassyradio",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "online.rassy.mrrassyradio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080c16"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    }
  }
}
