NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://rassys.com
RASSYS_RELEASE_VERSION=2.0.0
DM_JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@postgres:5432/rassy
REDIS_URL=redis://redis:6379
# Separate host roots for Notes, Learn, and Reports under media/data/web-rassys.
HOST_NOTES_PATH=/data/runtipi/media/data/web-rassys/notes
NOTES_STORAGE_PATH=/media/notes
HOST_LEARNING_PATH=/data/runtipi/media/data/web-rassys/learning
LEARNING_STORAGE_PATH=/media/learning
HOST_REPORTS_PATH=/data/runtipi/media/data/web-rassys/reports
RASSY_REPORTS_STORAGE_PATH=/media/reports
# These values select the Immich albums that are allowed in the public gallery.
IMMICH_BASE_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_NAME=
IMMICH_ALBUM_ID=
# OpenFang keeps its archive and also exports applicable analyst/system reports
# into HOST_REPORTS_PATH for the site's reviewed report reader.
OPENFANG_REPORTS_HOST_PATH=/data/apps/openfang/reports
