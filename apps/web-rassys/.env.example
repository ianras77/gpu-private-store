NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://rassys.com
RASSYS_RELEASE_VERSION=2.0.0
DM_JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@postgres:5432/rassy
REDIS_URL=redis://redis:6379
# Absolute host folder containing one published or draft module directory per subfolder.
HOST_LEARNING_PATH=/absolute/path/to/rassy-learning
LEARNING_STORAGE_PATH=/media/learning
# These values select the Immich albums that are allowed in the public gallery.
IMMICH_BASE_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_NAME=
IMMICH_ALBUM_ID=
# OpenFang reports are mounted read-only for the site's reviewed report reader.
OPENFANG_REPORTS_HOST_PATH=/data/apps/openfang/reports
