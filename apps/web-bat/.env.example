# Local ports
BAT_WEB_PORT=3197
BAT_API_PORT=8017
BAT_SOCIAL_PORT=8117
BAT_QDRANT_PORT=6337
BAT_POSTGRES_PORT=5437
BAT_REDIS_PORT=6387
BAT_CAT_PORT=1866

# Internal service URLs
DATABASE_URL=postgresql+psycopg://bat:bat_password_change_me@bat-postgres:5432/bat
REDIS_URL=redis://bat-redis:6379/0
QDRANT_URL=http://bat-qdrant:6333
SOCIAL_PUBLISHER_URL=http://bat-social-publisher:8100
CHESHIRE_CAT_URL=http://bat-cheshire-cat:80
CHESHIRE_CAT_API_KEY=change_me

# Host-facing URLs
# Leave blank to keep the browser on the web app's same-origin `/api/v1` proxy.
NEXT_PUBLIC_API_BASE_URL=
API_INTERNAL_BASE_URL=http://bat-api:8000
SEARXNG_BASE_URL=https://search.rasies.com

# Model routing
LLM_API_URL=http://127.0.0.1:8844/api/chat
LLM_API_KEY=
LLM_MODEL=rassy-smart
EMBEDDING_API_URL=http://127.0.0.1:8844/api/embed
EMBEDDING_MODEL=rassy-embed
OLLAMA_GENERAL_BASE_URL=http://host.docker.internal:8844
OLLAMA_EMBED_BASE_URL=http://host.docker.internal:8844
LLM_API_URL_CONTAINER=http://host.docker.internal:8844/api/chat
EMBEDDING_API_URL_CONTAINER=http://host.docker.internal:8844/api/embed
LLM_MODEL_CONTAINER=rassy-smart
EMBEDDING_MODEL_CONTAINER=rassy-embed
OLLAMA_GENERAL_BASE_URL_CONTAINER=http://host.docker.internal:8844
OLLAMA_EMBED_BASE_URL_CONTAINER=http://host.docker.internal:8844
OLLAMA_GENERAL_MODEL_CONTAINER=rassy-smart
OLLAMA_EMBED_MODEL_CONTAINER=rassy-embed
OLLAMA_NETWORK_NAME=runtipi_tipi_main_network
OLLAMA_GENERAL_MODEL=rassy-smart
OLLAMA_EMBED_MODEL=rassy-embed
CAT_OLLAMA_GENERAL_BASE_URL=http://host.docker.internal:8844
CAT_OLLAMA_GENERAL_MODEL=rassy-smart
CAT_OLLAMA_EMBED_BASE_URL=http://host.docker.internal:8844
CAT_OLLAMA_EMBED_MODEL=rassy-embed
OLLAMA_NUM_CTX=8192
OLLAMA_REPEAT_LAST_N=96
OLLAMA_REPEAT_PENALTY=1.12
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=15m
CAT_PRIMARY_ENABLED=false
CAT_SECONDARY_MEMORY_ENABLED=true
CAT_SECONDARY_MEMORY_MIN_QUALITY=4.8
CAT_SECONDARY_MEMORY_RECALL_LIMIT=8
CAT_SECONDARY_MEMORY_MAX_CHARS=1800
CAT_REQUEST_TIMEOUT_SECONDS=45
CAT_HEALTH_TIMEOUT_SECONDS=12
LLM_REQUEST_TIMEOUT_SECONDS=90
EMBEDDING_REQUEST_TIMEOUT_SECONDS=12
EMBEDDING_REQUEST_RETRIES=1
EMBEDDING_BATCH_SIZE=8
OUTBOUND_HTTP_MAX_CONNECTIONS=40
OUTBOUND_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
CAT_BOOTSTRAP_WAIT_SECONDS=15

# Publishing defaults
ENABLE_MANUAL_REVIEW=true
AUTO_PUBLISH=false
AUTO_PUBLISH_SOCIAL=false
DIRECT_PUBLISH_DEFAULT=false

# Pipeline depth
WORKER_CYCLE_MINUTES=30
WORKER_MIN_CYCLE_SECONDS=30
PIPELINE_LOCK_TTL_SECONDS=3600
PIPELINE_STALE_AFTER_SECONDS=1800
WRITER_THEME_TAKE_LIMIT=6
QUEEN_CURATION_LIMIT=8
BACKLOG_PUBLISH_WINDOW_HOURS=72
EDITORIAL_REWORK_QUEUE_LIMIT=6
EDITORIAL_REWORK_MAX_ATTEMPTS=6
EDITORIAL_REWORK_PASSES_PER_CYCLE=2
RETRIEVAL_MAX_SOURCES=10
RETRIEVAL_MAX_THEMES=6
RETRIEVAL_MAX_TRENDS=8
ANALYSIS_SOURCE_LIMIT=8
ANALYSIS_THEME_LIMIT=6
ANALYSIS_RECENT_EDITORIAL_LIMIT=16
ANALYSIS_MAX_BRIEFS=14
CURRENT_NEWS_MIN_YEAR=2026
CURRENT_NEWS_MAX_AGE_DAYS=7

# X / social publishing
X_ENABLED=false
X_DRY_RUN=true
X_RESEARCH_ENABLED=false
X_API_BASE_URL=https://api.x.com
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
