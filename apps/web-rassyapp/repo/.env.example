HOST_PORT=3189
CAT_HOST_PORT=3185
QDRANT_HOST_PORT=6333
# App
APP_SESSION_SECRET=replace-with-strong-secret

# Cheshire Cat Core
CAT_HTTP_BASE=http://localhost:3185
CAT_WS_BASE=ws://localhost:3185
CAT_HTTP_API_KEY=
CAT_WS_API_KEY=
# These credentials are provisioned into this package-owned Cheshire Cat instance at startup.
CAT_ADMIN_USERNAME=admin
CAT_ADMIN_PASSWORD=admin

# Ollama bootstrap
OLLAMA_BASE_URL=http://ollama-general:11434
OLLAMA_EMBED_BASE_URL=http://ollama-embed:11434
OLLAMA_LLM_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_APPLY_EMBEDDER=1
BOOTSTRAP_TIMEOUT_SECONDS=180

# Database
DATABASE_URL=file:./dev.db
