FROM node:18-bullseye-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
  dos2unix \
  netcat-openbsd \
  python3 \
  make \
  g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /next

COPY package*.json ./
RUN npm ci

COPY . .

RUN dos2unix /next/entrypoint.sh /next/wait-for-db.sh \
  && chmod +x /next/entrypoint.sh /next/wait-for-db.sh

ARG NEXT_PUBLIC_BACKEND_URL=/platform
ARG NEXT_PUBLIC_VERCEL_ENV=production
ARG NEXT_PUBLIC_MAX_LOOPS=25

ENV SKIP_ENV_VALIDATION=1
ENV NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL}
ENV NEXT_PUBLIC_VERCEL_ENV=${NEXT_PUBLIC_VERCEL_ENV}
ENV NEXT_PUBLIC_MAX_LOOPS=${NEXT_PUBLIC_MAX_LOOPS}

RUN npx prisma generate && npm run build

EXPOSE 3000

ENTRYPOINT ["sh", "/next/entrypoint.sh"]
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
