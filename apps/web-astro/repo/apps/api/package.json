{
  "name": "@astro/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "esoterica:index": "tsx scripts/index-esoterica.ts",
    "esoterica:dry-run": "tsx scripts/index-esoterica.ts --dry-run",
    "content:worker": "tsx src/workers/content-engine.ts",
    "content:run": "CONTENT_ENGINE_RUN_ONCE=1 tsx src/workers/content-engine.ts",
    "smoke:geo": "bash scripts/geo-smoke.sh",
    "lint": "echo 'lint not configured'",
    "test": "vitest --run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@astro/astro-core": "workspace:*",
    "@astro/astro-analysis": "workspace:*",
    "@astro/astro-intelligence": "workspace:*",
    "@astro/astro-engine-astro": "workspace:*",
    "@astro/astro-engine-swiss": "workspace:*",
    "@astro/reading-core": "workspace:*",
    "@astro/brands": "workspace:*",
    "@astro/utils": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "openai": "^4.56.0",
    "pdf-parse": "^1.1.1",
    "epub2": "^3.0.1",
    "fastify": "^5.0.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "@prisma/client": "^5.19.0"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "tsx": "^4.19.2",
    "vitest": "^2.0.5"
  }
}
