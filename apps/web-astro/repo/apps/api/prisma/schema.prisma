generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  displayName  String?
  passwordHash String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  charts       ChartProfile[]
  sessions     AuthSession[]
  content      ContentEntry[]
  jobs         ContentJob[]
  reportRuns   ReportRun[]
  conversations AstroConversation[]
  feedback     AstroFeedback[]
}

model AuthSession {
  id         String   @id @default(uuid())
  userId     String   @db.Uuid
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ChartProfile {
  id            String         @id @default(uuid())
  userId        String         @db.Uuid
  brandId       String
  label         String?
  birthDate     String
  birthTimeEnc  String?
  timeUnknown   Boolean        @default(false)
  latEnc        String?
  lonEnc        String?
  timezone      String
  locationLabel String?
  houseSystem   String?
  chartHash     String
  chartJson     Json
  isPrimary     Boolean        @default(false)
  autoWeekly    Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  readings      Reading[]
  content       ContentEntry[]
  jobs          ContentJob[]
  reportRuns    ReportRun[]

  @@index([userId])
  @@index([userId, brandId])
  @@index([userId, brandId, isPrimary])
  @@index([chartHash])
}

model Reading {
  id             String        @id @default(uuid())
  chartProfileId String
  brandId        String
  kind           String        @default("natal")
  length         String
  title          String?
  excerpt        String?
  readingJson    Json
  provider       String?
  model          String?
  isFallback     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  chartProfile   ChartProfile  @relation(fields: [chartProfileId], references: [id], onDelete: Cascade)
  contentEntry   ContentEntry?

  @@index([chartProfileId])
  @@index([brandId, kind, createdAt])
}

model ContentEntry {
  id             String        @id @default(uuid())
  userId         String        @db.Uuid
  chartProfileId String?
  readingId      String?       @unique
  brandId        String
  kind           String
  status         String        @default("published")
  slug           String
  title          String
  excerpt        String
  bodyJson       Json
  meta           Json?
  weekOf         DateTime?
  publishedAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartProfile   ChartProfile? @relation(fields: [chartProfileId], references: [id], onDelete: SetNull)
  reading        Reading?      @relation(fields: [readingId], references: [id], onDelete: SetNull)
  jobs           ContentJob[]

  @@unique([userId, brandId, slug])
  @@index([userId, brandId, publishedAt])
  @@index([chartProfileId, publishedAt])
}

model ContentJob {
  id             String        @id @default(uuid())
  userId         String?       @db.Uuid
  chartProfileId String?
  contentEntryId String?
  brandId        String
  kind           String
  status         String        @default("queued")
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  requestJson    Json?
  resultJson     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  chartProfile   ChartProfile? @relation(fields: [chartProfileId], references: [id], onDelete: SetNull)
  contentEntry   ContentEntry? @relation(fields: [contentEntryId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([brandId, kind, createdAt])
}

model ReportRun {
  id             String   @id @default(uuid())
  userId         String?  @db.Uuid
  chartProfileId String?
  brandId        String
  kind           String
  depth          String
  status         String   @default("queued")
  idempotencyKey String?
  inputHash      String
  inputJson      Json
  workflowVersion String
  traceId        String?
  errorClass     String?
  errorMessage   String?
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  chartProfile   ChartProfile? @relation(fields: [chartProfileId], references: [id], onDelete: SetNull)
  sections       ReportSection[]
  artifact       ReportArtifact?
  feedback       AstroFeedback[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReportSection {
  id             String   @id @default(uuid())
  reportRunId    String
  sectionKey     String
  position       Int
  status         String   @default("queued")
  payload        Json?
  factRefs       Json?
  loreRefs       Json?
  modelProfile   String?
  attemptCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reportRun      ReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  @@unique([reportRunId, sectionKey])
  @@index([reportRunId, position])
}

model ReportArtifact {
  id             String   @id @default(uuid())
  reportRunId    String   @unique
  schemaVersion  String
  reportVersion  String
  title          String
  excerpt        String?
  payload        Json
  provenance     Json?
  legacyReadingId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reportRun      ReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
}

model AstroConversation {
  id              String   @id @default(uuid())
  userId          String   @db.Uuid
  chartProfileId  String?
  brandId         String
  resourceId      String
  threadId        String   @unique
  memoryEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model AstroFeedback {
  id          String   @id @default(uuid())
  userId      String?  @db.Uuid
  reportRunId String?
  sectionKey  String?
  rating      String
  comment     String?
  workflowVersion String?
  brandId     String?
  createdAt   DateTime @default(now())
  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  reportRun   ReportRun? @relation(fields: [reportRunId], references: [id], onDelete: SetNull)
  @@index([reportRunId, createdAt])
}
