# Parameterized immutable web image. Build with --build-arg APP_NAME=@astro/web-jupiterseek.
FROM node:20-bookworm AS build
ARG APP_NAME
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json tsconfig.build.base.json ./
COPY apps apps
COPY packages packages
RUN pnpm install --frozen-lockfile && pnpm --filter "${APP_NAME}" build

FROM node:20-bookworm-slim AS runtime
ARG APP_NAME
WORKDIR /repo
ENV NODE_ENV=production
RUN useradd --create-home --uid 10001 astro
COPY --from=build --chown=astro:astro /repo /repo
USER astro
EXPOSE 3000
CMD ["sh", "-c", "pnpm --filter \"${APP_NAME}\" exec next start -p 3000 -H 0.0.0.0"]
