ESOTERICA_ROTATE_DAILY=0
ESOTERICA_STRICT_BRAND_FILTER=0
ESOTERICA_AUTO_REFRESH=0
ESOTERICA_REFRESH_HOURS=24
ESOTERICA_REFRESH_ON_START=0
GEO_ACCEPT_LANGUAGE=en
GEO_CACHE_MAX=1000
GEO_CACHE_TTL_SECONDS=604800
GEO_RATE_LIMIT_MAX=90
GEO_RATE_LIMIT_WINDOW_MS=60000
READING_RATE_LIMIT_MAX=20
READING_RATE_LIMIT_WINDOW_MS=60000
GEO_PROVIDER_ALLOW_NOMINATIM_IN_PROD=false
