# API
PORT=4020
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://astro:astro@localhost:5432/astro
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
ALLOW_DEV_AUTH=false
DEV_USER_ID=
DEV_USER_EMAIL=
ASTRO_ENGINE=swiss
SWISS_EPHEMERIS_ENABLED=true
SWISS_EPHEMERIS_PATH=
## Deprecated compatibility aliases; use RASSYMIND_* above.
RASSYMIND_ENABLED=1
ASTRO_LEGACY_LLM_ENABLED=0
RASSYMIND_API_KEY=
RASSYMIND_CAPABILITIES_JSON=
RASSYMIND_BASE_URL=http://host.docker.internal:8844/v1
RASSYMIND_MODEL=rassy-fast
RASSYMIND_SESSION_ID=astro:anonymous
RASSYMIND_DEADLINE_MS=60000
ESOTERICA_INDEX_PATH=./data/esoterica/index.jsonl
ESOTERICA_AUDIT_LOG=0
ESOTERICA_AUDIT_LOG_PATH=./data/esoterica/lore-audit.jsonl
ESOTERICA_EMBED_MODEL=text-embedding-3-large
ESOTERICA_EMBED_BASE_URL=http://host.docker.internal:8844/v1
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=esoterica
ESOTERICA_ROTATE_DAILY=0
ESOTERICA_STRICT_BRAND_FILTER=0
ESOTERICA_AUTO_REFRESH=0
ESOTERICA_REFRESH_HOURS=24
ESOTERICA_REFRESH_ON_START=0
GEO_ACCEPT_LANGUAGE=en
GEO_CACHE_MAX=1000
GEO_CACHE_TTL_SECONDS=604800
GEO_RATE_LIMIT_MAX=90
GEO_RATE_LIMIT_WINDOW_MS=60000
READING_RATE_LIMIT_MAX=20
READING_RATE_LIMIT_WINDOW_MS=60000
GEO_PROVIDER_ALLOW_NOMINATIM_IN_PROD=false
GEO_FALLBACK_ON_EMPTY_RESULTS=0
MAPBOX_TOKEN=
OPENCAGE_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=astro-multibrand/1.0
NOMINATIM_CONTACT_EMAIL=you@domain.com
NOMINATIM_MAX_RPS=1

# Legacy geo envs (still honored as fallback)
GEO_API_BASE=https://nominatim.openstreetmap.org
GEO_EMAIL=
GEO_USER_AGENT=astro-multibrand/1.0

# Web apps
NEXT_PUBLIC_API_BASE=http://localhost:4020

# Optional services
REDIS_URL=redis://localhost:6379
RASSYMIND_BASE_URL=http://host.docker.internal:8844/v1
RASSYMIND_API_KEY=
ASTRO_RASSYMIND_ENABLED=0
ASTRO_RASSYMIND_FAST_MODEL=rassy-fast
ASTRO_RASSYMIND_MIND_MODEL=rassy-mind
ASTRO_RASSYMIND_UTILITY_MODEL=rassy-utility
ASTRO_RASSYMIND_EMBED_MODEL=rassy-embed
ASTRO_RASSYMIND_RERANK_MODEL=rassy-rerank
ASTRO_MASTRA_ENABLED=0
ASTRO_MASTRA_STUDIO_ENABLED=0
ASTRO_REPORT_WORKFLOW_VERSION=life-handbook-v1
ASTRO_REPORT_MAX_PARALLEL_STEPS=2
ASTRO_REPORT_MAX_MODEL_CALLS=24
ASTRO_REPORT_MAX_TOOL_CALLS=48
