# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# iOS (Expo)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_CAPTURE_MODE=gps

# API
APP_ENV=dev
DATABASE_URL=postgresql+psycopg2://jogmania:jogmania@postgres:5432/jogmania
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
AUTH_COOKIE_NAME=jm_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRE_HOURS=48

# MinIO / S3
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jogmania-exports
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ENABLED=true

# Optional LLM flavor text
ADVENTURE_LLM_URL=
ADVENTURE_LLM_API_KEY=
ADVENTURE_LLM_MODEL=

# Optional SMTP (only required if AUTH_REQUIRE_EMAIL_VERIFICATION=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
